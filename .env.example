# Local overrides for the pipeline services (copy to .env, gitignored).
#
# GCP project that owns our own dataset. The public Ethereum dataset is
# read from bigquery-public-data; this is where dbt materializes models.
DBT_PROJECT=cor-sample-nansen

# Dataset dbt builds into (created by the bigquery-init service).
DBT_DATASET=nansen_labels_dev

# BigQuery location - must match the public dataset's (US multi-region).
DBT_LOCATION=US

# HARD FLOOR for every source scan. The public dataset is petabyte-scale:
# no model ever reads before this date, including incremental runs (the
# lookback is clamped with greatest()). Not a tuning knob - leave it.
START_DATE=2026-09-23

# No host paths here on purpose: the Prefect worker starts dbt as a sibling
# container through the host Docker socket, and translates its own mount
# paths to host paths at runtime (see flows/label_pipeline.py::_host_path).
# That keeps this file machine independent.
